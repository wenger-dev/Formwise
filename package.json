    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src plugins",
    "test": "tsx --test src/test/*.test.ts",
    "test:ui": "jest --runInBand",
    "build:android": "npx eas-cli@latest build --platform android --profile preview",
    "export:web": "expo export --platform web",
    "export:android": "expo export --platform android --output-dir dist-android"
  },
  "private": true,
  "overrides": {
    "expo": {
      "zod": "$zod"
